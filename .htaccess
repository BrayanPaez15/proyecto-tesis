# SIRAD - proteccion de archivos internos.
# Requiere que Apache tenga AllowOverride All en la carpeta del proyecto y mod_rewrite
# (XAMPP los trae). Si el proyecto se publica en otro servidor, mueva db/, logs/ e includes/
# fuera de la carpeta publica o configure reglas equivalentes.

# Sin listado de carpetas
Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
    RewriteEngine On
    # El repositorio Git no se sirve (y tampoco la copia anidada proyecto-tesis/, una version antigua sin las protecciones actuales)
    RewriteRule (^|/)\.git(/|$) - [R=404,L]
    # Esquema, respaldos, migraciones, registros de errores y archivos compartidos: solo internos
    RewriteRule ^(db|logs|includes|proyecto-tesis)(/|$) - [F,L]
</IfModule>

# Solo GET, POST y HEAD (TRACE reflejaria la peticion con sus cookies; la aplicacion no usa otros metodos)
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>

# Archivos que no deben descargarse
<FilesMatch "(^\.|\.(sql|log|md|bak|ini|bat|ps1|sh|drawio)$)">
    Require all denied
</FilesMatch>

# Configuracion y guardas: se usan solo con require desde otros scripts
<FilesMatch "^(config|config\.local|conexion|auth)\.php$">
    Require all denied
</FilesMatch>

# Hojas de estilo y scripts: el navegador los revalida siempre (las paginas ademas los piden con ?v=fecha del archivo),
# asi un cambio en el sistema se ve de inmediato sin tener que vaciar la cache.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
